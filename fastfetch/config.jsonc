{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "type": "custom",
      "key": "╭───────────╮"
    },
    {
      "type": "title",
      "key": "│  user    {#keys}│",
      "format": "{user-name}"
    },
    {
      "type": "title",
      "key": "│ 󰇅 hname   {#keys}│",
      "format": "{host-name}"
    },
    {
      "type": "command",
      "key": "│ 󱦟 os age  {#keys}│",
      "keyColor": "magenta",
      "text": "btime=$(stat -c %W / 2>/dev/null); [ \"$btime\" -gt 0 ] 2>/dev/null || btime=$(stat -c %W /var/log 2>/dev/null || echo 0); if [ \"$btime\" -gt 0 ]; then printf '\\e[0m%s days\\e[0m' \"$(( ($(date +%s) - btime) / 86400 ))\"; else echo 'unknown'; fi"
    },
    {
      "type": "uptime",
      "key": "│ 󰅐 uptime  {#keys}│"
    },
    {
      "type": "os",
      "key": "│ {icon} distro  {#keys}│"
    },
    {
      "type": "kernel",
      "key": "│  kernel  {#keys}│"
    },
    {
      "type": "wm",
      "key": "│  wm      {#keys}│"
    },
    {
      "type": "terminal",
      "key": "│  term    {#keys}│"
    },
    {
      "type": "shell",
      "key": "│  shell   {#keys}│"
    },
    {
      "type": "cpu",
      "key": "│ 󰍛 cpu     {#keys}│",
      "showPeCoreCount": true
    },
    {
      "type": "battery",
      "key": "│ 󰁹 battery {#keys}│"
    },
    {
      "type": "memory",
      "key": "│  memory  {#keys}│"
    },
    {
      "type": "disk",
      "key": "│ 󰉉 disk    {#keys}│",
      "folders": "/"
    },
    {
      "type": "custom",
      "key": "├───────────┤"
    },
    {
      "type": "colors",
      "key": "│  colors  {#keys}│",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "key": "╰───────────╯"
    }
  ]
}
